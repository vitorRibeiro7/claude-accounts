#!/usr/bin/env bash
# claude-auto — open Claude on the active account and CONTINUE this directory's conversation
# if there is one; if the directory never had a session, start a new one.
#
# Why: `claude --continue` is per directory and ABORTS when the directory never had a session;
# without it, reopening a terminal in an old directory starts empty. No flag does both, so this
# script decides. Handy for tools that always launch Claude with the same command (IDEs,
# Maestri, terminal presets…).
HERE="$(cd "$(dirname "$0")" && pwd)"
if [ -z "${CLAUDE_CONFIG_DIR:-}" ]; then
  d="$("$HERE/claude-accounts" _dir)" || exit 1     # empty = default account (~/.claude)
  [ -n "$d" ] && export CLAUDE_CONFIG_DIR="$d"
fi

# Claude stores conversations in <account dir>/projects/<path with / and . turned into ->
project="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/${PWD//[\/.]/-}"

[ -n "$(compgen -G "$project/*.jsonl" 2>/dev/null)" ] || exec "$HERE/claude" "$@"

# `--continue` can refuse at startup, e.g. when the last conversation became a background
# session ("moved to a background session … registered from another machine or container").
# Then it exits with an error within a few seconds; start a new session instead of failing.
# Not a fork: the background transcript can be huge, and copying it on every launch is costly.
start=$SECONDS
"$HERE/claude" --continue "$@"
code=$?
if [ "$code" -ne 0 ] && [ $((SECONDS - start)) -lt "${CLAUDE_AUTO_GRACE:-5}" ]; then
  echo "claude-auto: couldn't continue the last conversation here (it may be a background session). Starting a new one; use 'claude --resume' to pick an old one." >&2
  exec "$HERE/claude" "$@"
fi
exit "$code"
