#!/usr/bin/env bash
# "claude" on the active account (see `ca`). This file sits BEFORE the real binary in PATH.
# Default account (~/.claude): no CLAUDE_CONFIG_DIR — its login lives in ~/.claude.json.
# An already-set CLAUDE_CONFIG_DIR wins (e.g. an alias that pins one account).
CFG="${CLAUDE_ACCOUNTS_DIR:-$HOME/.config/claude-accounts}"
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
[ -r "$CFG/config" ] && . "$CFG/config"           # defines CLAUDE_REAL (written by install.sh)

# Claude Code moved? Look for the real one in PATH, skipping this wrapper.
if [ ! -x "${CLAUDE_REAL:-}" ]; then
  CLAUDE_REAL=""
  IFS=: read -ra dirs <<< "$PATH"
  for d in "${dirs[@]}"; do
    [ "$d" = "$HERE" ] && continue
    [ -x "$d/claude" ] && ! head -c 600 "$d/claude" 2>/dev/null | grep -aqE 'CLAUDE_ACCOUNTS_DIR|CLAUDE_CONTAS_DIR' && { CLAUDE_REAL="$d/claude"; break; }
  done
  [ -n "$CLAUDE_REAL" ] || { echo "claude-accounts: real 'claude' not found — install Claude Code, then re-run install.sh" >&2; exit 1; }
fi

if [ -z "${CLAUDE_CONFIG_DIR:-}" ]; then
  d="$("$HERE/claude-accounts" _dir)" || exit 1
  [ -n "$d" ] && export CLAUDE_CONFIG_DIR="$d"
fi

# Register the session so `ca sessions` / `ca stop` work on every OS (no /proc on macOS).
# exec keeps the PID, so this file describes the Claude process itself.
mkdir -p "$CFG/sessions" 2>/dev/null && \
  printf '%s\n%s\n%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$PWD" "$(ps -o lstart= -p $$ 2>/dev/null)" > "$CFG/sessions/$$" 2>/dev/null

# CLAUDE_REAL points to the `claude` link, not the versioned file behind it, so the process
# keeps the name "claude".
exec "$CLAUDE_REAL" "$@"
